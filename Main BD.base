formulas:
  Без названия: ""
  Без названия 2: ""
views:
  - type: table
    name: Тренировки
    filters:
      and:
        - file.folder.contains("Тренировки")
    order:
      - file.name
      - tags
      - Grade
      - file.tags
    sort:
      - property: тренировка
        direction: ASC
    summaries: {}
    columnSize:
      file.name: 224
      file.tags: 318
  - type: table
    name: Упражнения
    filters:
      and:
        - file.folder.contains("1.2. Упражнения")
    order:
      - file.name
      - Скилл
      - tags
      - file.ctime
    columnSize:
      note.tags: 191
  - type: table
    name: Информация
    filters:
      and:
        - file.tags.contains("Инфо")
    order:
      - file.name
      - file.tags
      - file.ctime
  - type: cards
    name: Люди
    filters:
      and:
        - file.tags.contains("люди")
    order:
      - file.name
      - tags
    image: note.Poster

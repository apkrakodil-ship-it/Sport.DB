formulas:
  Без названия: ""
views:
  - type: table
    name: Тренировки
    filters:
      and:
        - file.folder.contains("Тренировки")
    order:
      - file.name
      - file.tags
    sort:
      - property: тренировка
        direction: ASC
    summaries: {}
    columnSize:
      file.name: 224
      file.tags: 318
  - type: table
    name: Упражнения
    filters:
      and:
        - file.folder.contains("02.Упражнения")
    order:
      - file.name
      - file.tags
  - type: table
    name: Информация
    filters:
      and:
        - file.folder.contains("Информация")
    order:
      - file.name
      - file.tags

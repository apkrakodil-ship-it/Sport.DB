formulas:
  Без названия: ""
  Без названия 2: ""
views:
  - type: table
    name: Тренировки
    filters:
      and:
        - file.folder.contains("Тренировки")
    order:
      - file.name
      - tags
      - Grade
      - file.tags
    sort:
      - property: тренировка
        direction: ASC
    summaries: {}
    columnSize:
      file.name: 224
      note.tags: 191
      note.Grade: 87
      file.tags: 318
  - type: cards
    name: Упражнения
    filters:
      and:
        - file.folder.contains("1.2. Упражнения")
        - Оборудование.contains("безВеса")
    order:
      - file.name
      - Скилл
      - tags
      - Today
    columnSize:
      note.tags: 191
      note.Today: 69
    image: note.Poster
  - type: table
    name: Информация
    filters:
      and:
        - file.tags.contains("Инфо")
    order:
      - file.name
      - file.tags
      - file.ctime
  - type: cards
    name: Люди
    filters:
      and:
        - file.tags.contains("люди")
    order:
      - file.name
      - tags
    image: note.Poster
  - type: cards
    name: Today
    filters:
      and:
        - Today == true
    order:
      - file.name
      - Мышцы
      - Тип
      - Сложность
      - Скилл
      - Отношение
      - Оборудование
    image: note.Poster

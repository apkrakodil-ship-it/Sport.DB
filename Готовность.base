formulas:
  Без названия: ""
views:
  - type: table
    name: Состояние заметок
    filters:
      or:
        - file.tags.contains("start")
        - file.tags.contains("mid")
    order:
      - file.name
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
  - type: table
    name: Non-Filter
    filters:
      and:
        - file.folder.contains("Non-Filter")
    order:
      - file.name
      - file.tags

formulas:
  Без названия: ""
views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.tags.contains("присед")
        - file.folder.contains("03.Тренировки")
    order:
      - file.name
      - file.tags
    sort:
      - property: тренировка
        direction: ASC
    summaries: {}
    columnSize:
      file.name: 224
      file.tags: 318

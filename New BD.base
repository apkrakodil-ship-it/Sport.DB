formulas:
  Без названия: ""
views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.tags.contains("упражнение")
        - file.tags.contains("спина")
    order:
      - file.name
      - file.tags
    sort:
      - property: тренировка
        direction: ASC
    summaries: {}
    columnSize:
      file.name: 211
      file.tags: 318
